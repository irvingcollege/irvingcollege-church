---
import { getCollection } from 'astro:content';
import sunday from '../content/sunday/current.json';
import bulletin from '../../public/bulletin/current.json';

function httpsLink(value: string, fallback: string) {
  try {
    const url = new URL(value);
    return url.protocol === 'https:' ? url.href : fallback;
  } catch {
    return fallback;
  }
}
type Announcement = {
  title: string;
  text?: string;
  image?: string;
  imageAlt?: string;
  buttonLabel?: string;
  buttonUrl?: string;
};
const announcements = (bulletin.announcements ?? []) as Announcement[];
const siteOrigin = 'https://irvingcollege.church';
function bulletinLink(value?: string) {
  if (!value?.trim()) return '';
  try {
    const raw = value.trim();
    const input = raw.startsWith('images/uploads/') ? '/' + raw : raw;
    const url = input.startsWith('/') ? new URL(input, siteOrigin) : new URL(input);
    if (url.protocol !== 'https:' || (input.startsWith('/') && url.origin !== siteOrigin)) return '';
    return url.origin === siteOrigin ? url.pathname + url.search + url.hash : url.href;
  } catch {
    return '';
  }
}
const banners = (bulletin.banners ?? []).map((banner: { image: string; description: string; url?: string }) => ({
  image: bulletinLink(banner.image),
  description: banner.description,
  url: bulletinLink(banner.url),
})).filter(banner => banner.image);
function agendaUrl(value?: string) {
  try {
    const url = new URL(value?.trim() ?? '');
    if (url.origin !== 'https://calendar.google.com' || url.pathname !== '/calendar/embed' ||
        !url.searchParams.get('src')) return '';
    url.searchParams.set('mode', 'AGENDA');
    url.searchParams.set('ctz', 'America/Chicago');
    url.searchParams.set('showTitle', '0');
    return url.href;
  } catch {
    return '';
  }
}
const calendarUrl = agendaUrl((sunday as { calendarUrl?: string }).calendarUrl);
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago' }).format(new Date());
const events = (await getCollection('events'))
  .filter(({ data }) => data.date.toISOString().slice(0, 10) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const scriptures = (sunday.scriptures ?? []) as { reference: string; text: string; translation?: string }[];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#41cfc1" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="apple-touch-icon" href="/images/sunday-icon.png" />
  <link rel="icon" href="/images/sunday-icon.png" />
  <link rel="manifest" href="/sunday.webmanifest" />
  <title>This Sunday | Irving College Baptist Church</title>
</head>
<body>
  <header>
    <a href="/" class="church-wordmark" aria-label="Irving College Baptist Church home">
      <img src="/images/sunday-header.png?v=2" alt="Irving College Baptist Church" width="1560" height="225" />
    </a>
  </header>
  <div class="cover">
    <img src="/images/hero/church-front.jpg" alt="Irving College Baptist Church" width="1672" height="941" fetchpriority="high" />
  </div>
  <main>
    <section id="message" class="hero">

      <h1>{sunday.title}</h1>
    </section>
    <section id="scripture" class="guide-section">
      <h2>Scripture</h2>
      {scriptures.length ? <ul class="passages">
        {scriptures.map((passage, index) => <li>
          <details class="passage">
            <summary class="passage-link">
              {passage.reference}
              <span class="read-passage" aria-hidden="true">Read</span>
              <span class="hide-passage" aria-hidden="true">Hide</span>
            </summary>
            <p class="translation">{passage.translation?.trim() || "CSB"}</p>
            <p class="verse-text">{passage.text}</p>
          </details>
        </li>)}
      </ul> : <p>Scripture passages will appear here when they’re published.</p>}
    </section>
    <section id="bulletin" class="guide-section">
      <h2>Weekly Bulletin</h2>
      {bulletin.text?.trim() && bulletin.text.trim().split(/\r?\n\s*\r?\n/).map(paragraph =>
        <p class="bulletin-text">{paragraph}</p>
      )}
      {banners.length > 0 && <div class="bulletin-banners">
        {banners.map(banner => banner.url ? (
          <a href={banner.url}><img src={banner.image} alt={banner.description} width="1560" height="450" loading="lazy" decoding="async" /></a>
        ) : <img src={banner.image} alt={banner.description} width="1560" height="450" loading="lazy" decoding="async" />)}
      </div>}
      {announcements.length > 0 && <div class="announcements">
        {announcements.map(item => {
          const image = bulletinLink(item.image);
          const action = bulletinLink(item.buttonUrl);
          return <article class="announcement">
            {image && <img src={image} alt={item.imageAlt ?? ''} loading="lazy" decoding="async" />}
            <div class="announcement-body">
              <h3>{item.title}</h3>
              {item.text && <p class="bulletin-text">{item.text}</p>}
              {action && <a class="action" href={action}>{item.buttonLabel?.trim() || 'View details'}</a>}
            </div>
          </article>;
        })}
      </div>}
      {!bulletin.text?.trim() && !announcements.length && !banners.length && <p>The weekly bulletin will appear here when it’s published.</p>}
    </section>
    <section id="events" class="guide-section">
      <h2>Calendar</h2>
      {calendarUrl ? <iframe class="calendar-agenda" src={calendarUrl} title="ICBC Google Calendar agenda" loading="lazy"></iframe> : events.length ? <ul>{events.map(({data}) => <li>
        <strong>{data.title}</strong>
        <p>{data.date.toLocaleDateString('en-US', {month:'long', day:'numeric', timeZone:'UTC'})} · {data.time} · {data.location}</p>
        <p>{data.description}</p>
      </li>)}</ul> : <p>Sunday School at 9:30 AM · Sunday Worship at 10:30 AM</p>}
    </section>
    <section id="give" class="guide-section">
      <h2>Give</h2>
      {httpsLink(sunday.givingUrl, '') && <p><a href={httpsLink(sunday.givingUrl, '')}>Give with Tithe.ly</a></p>}
      <a href="https://venmo.com/irvingcollege">Give with Venmo</a>
    </section>
    <section id="watch" class="guide-section">
      <h2>Watch</h2>
      <div id="sunday-live" hidden>
        <p role="status"><strong class="live-badge">Live now</strong></p>
        <div id="sunday-live-player"></div>
      </div>
      <h3 id="archive-title">Past Sermons</h3>
      <select id="archive-select" aria-labelledby="archive-title" aria-describedby="archive-status" disabled>
        <option value="">Choose a sermon</option>
      </select>
      <p id="archive-status" role="status">Loading sermons…</p>
      <div id="archive-player" hidden><h4 id="archive-playing"></h4><video id="archive-video" controls playsinline preload="none"></video></div>
      <p><a href={httpsLink(sunday.watchUrl, 'https://www.youtube.com/@irvingcollege.church')}>Watch on YouTube</a></p>
    </section>
    {scriptures.some(passage => !passage.translation?.trim() || /^(csb|christian standard bible)$/i.test(passage.translation.trim())) && <footer class="scripture-credit"><small>Scripture quotations marked CSB are from the Christian Standard Bible®, copyright © 2017 by Holman Bible Publishers. Used by permission.</small></footer>}
    <p id="install-link" hidden><button type="button" data-install>Add to Home Screen</button></p>
  </main>
  <aside id="install-reminder" hidden aria-label="Add the Sunday app to your phone">
    <button type="button" data-install>Add to Home Screen</button>
  </aside>
  <dialog id="install-help" aria-labelledby="install-title">
    <h2 id="install-title">Add to Home Screen</h2>
    <p id="install-steps"></p>
    <form method="dialog"><button autofocus>Close</button></form>
  </dialog>
  <nav aria-label="Sunday app"><a href="#message">Message</a><a href="#scripture">Scripture</a><a href="#bulletin">Bulletin</a><a href="#events">Events</a><a href="#give">Give</a><a href="#watch"><span id="watch-nav-label">Watch</span></a></nav>
</body>
</html>
<script>
  const archiveStatus = document.getElementById('archive-status')!;
  const archiveSelect = document.querySelector<HTMLSelectElement>('#archive-select')!;
  const archivePlayer = document.getElementById('archive-player')!;
  const archiveVideo = document.querySelector<HTMLVideoElement>('#archive-video')!;
  const archivePlaying = document.getElementById('archive-playing')!;
  let archiveKey = '';
  function renderArchive(value: unknown) {
    const items = Array.isArray(value) ? value.filter(s => s && typeof s.date === 'string' && typeof s.url === 'string' && s.url.startsWith('https://live.irvingcollege.church/sermons/')) : [];
    if (!items.length) {
      if (!archiveKey) archiveStatus.textContent = 'No recordings available right now.';
      return;
    }
    const key = JSON.stringify(items);
    if (key === archiveKey) return;
    archiveKey = key;
    archiveStatus.textContent = '';
    const selected = archiveSelect.value;
    archiveSelect.replaceChildren();
    for (const sermon of items) {
      const date = new Date(sermon.date + 'T12:00:00Z');
      const label = Number.isNaN(date.getTime()) ? sermon.date : date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric', timeZone:'UTC'});
      const title = typeof sermon.title === 'string' && sermon.title.trim() ? sermon.title : label;
      const option = document.createElement('option');
      option.value = sermon.url;
      option.textContent = title === label ? title : title + ' · ' + label;
      archiveSelect.append(option);
    }
    archiveSelect.disabled = false;
    if (items.some(sermon => sermon.url === selected)) archiveSelect.value = selected;
    loadRecording(false);
  }
  function loadRecording(play: boolean) {
    const option = archiveSelect.selectedOptions[0];
    if (!option || archiveVideo.getAttribute('src') === option.value) return;
    archivePlaying.textContent = option.textContent;
    archiveVideo.src = option.value;
    archivePlayer.hidden = false;
    archiveStatus.textContent = '';
    if (play) void archiveVideo.play().catch(() => {});
  }
  archiveSelect.addEventListener('change', () => loadRecording(true));
  archiveVideo.addEventListener('error', () => {
    archiveStatus.textContent = 'This recording couldn’t play. Try another sermon or watch on YouTube.';
  });
  const watchLabel = document.getElementById('watch-nav-label');
  const live = document.getElementById('sunday-live');
  const player = document.getElementById('sunday-live-player');
  if (live && player) {
    let checking = false;
    const refresh = async () => {
      if (checking) return;
      checking = true;
      try {
        const response = await fetch('/.netlify/functions/worship-feed', { cache: 'no-store' });
        if (!response.ok) throw new Error('Feed unavailable');
        const { online, sermons } = await response.json();
        renderArchive(sermons);
        if (online === true && live.hidden) {
          const frame = document.createElement('iframe');
          frame.src = 'https://live.irvingcollege.church/embed/video?autoplay=off';
          frame.title = 'Irving College Baptist Church livestream';
          frame.referrerPolicy = 'origin';
          frame.allow = 'fullscreen; picture-in-picture';
          frame.allowFullscreen = true;
          player.replaceChildren(frame);
          live.hidden = false;
          if (watchLabel) watchLabel.textContent = "● Live";
        } else if (online === false && !live.hidden) {
          live.hidden = true;
          if (watchLabel) watchLabel.textContent = "Watch";
          player.replaceChildren();
        }
      } catch {
        // Keep any playing stream visible during a temporary connection failure.
        if (!archiveKey) archiveStatus.textContent = 'Sermon archive temporarily unavailable. Please try again shortly.';
      } finally {
        checking = false;
      }
    };
    void refresh();
    window.setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refresh();
    });
  }

  type InstallPrompt = Event & {
    prompt: () => Promise<{ outcome: 'accepted' | 'dismissed' }>;
  };
  const reminder = document.getElementById('install-reminder');
  const installLink = document.getElementById('install-link');
  const help = document.querySelector<HTMLDialogElement>('#install-help');
  const steps = document.getElementById('install-steps');
  const ios = /iPhone|iPad|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const android = /Android/.test(navigator.userAgent);
  const installed = () => window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;
  let prompt: InstallPrompt | undefined;
  function hideInstall() {
    if (reminder) reminder.hidden = true;
    if (installLink) installLink.hidden = true;
  }
  window.addEventListener('appinstalled',hideInstall);
  window.addEventListener('beforeinstallprompt', event => {
    if ((!ios && !android) || installed()) return;
    event.preventDefault();
    prompt = event as InstallPrompt;
  });
  if ((ios || android) && !installed() && reminder && installLink) {
    reminder.hidden = false;
    installLink.hidden = false;
    window.setTimeout(() => {
      if (reminder.contains(document.activeElement)) {
        reminder.addEventListener('focusout', () => { reminder.hidden = true; }, {once:true});
      } else {
        reminder.hidden = true;
      }
    },3000);
    for (const button of document.querySelectorAll('[data-install]')) {
      button.addEventListener('click', async () => {
        if (prompt) {
          const current = prompt;
          prompt = undefined;
          try {
            const result = await current.prompt();
            if (result.outcome === 'accepted') hideInstall();
            return;
          } catch {
            // Show manual steps if the browser declines to open its install prompt.
          }
        }
        if (!help || !steps || help.open) return;
        steps.textContent = ios
          ? 'Open this page in Safari. Tap Share, then Add to Home Screen. Turn on Open as Web App if shown, then tap Add.'
          : 'Open this page in Chrome. Tap the three-dot menu, then Add to home screen or Install app.';
        help.showModal();
      });
    }
  }
</script>
<style>
  :global(body) {
    margin: 0;
    background: #ffffff;
    color: #101010;
    font: 16px/1.6 system-ui, sans-serif;
    padding-bottom: calc(70px + env(safe-area-inset-bottom));
  }
  header { background: #41cfc1; color: #101010; }
  .church-wordmark { display:block; max-width:940px; margin:auto; }
  .church-wordmark img { display:block; width:100%; height:auto; }
  .cover { background: #41cfc1; }
  .cover img {
    display: block; width: 100%; max-width: 1200px; height: clamp(170px, 37vw, 405px);
    object-fit: cover; object-position: center 55%; margin: auto;
  }
  main { max-width: 940px; margin: auto; padding: 0 clamp(20px, 5vw, 54px); }
  section { scroll-margin-top: 14px; }
  .hero { position: relative; padding: clamp(26px, 5vw, 56px) 0; }
  h1, h2 { font-family: system-ui, sans-serif; font-weight: 700; }
  h1 { font-size: clamp(2.35rem, 7vw, 4.75rem); line-height: 1.08; letter-spacing: -.045em; margin: .22em 0; }
  h2 { font-size: clamp(1.65rem, 4vw, 2.65rem); line-height: 1.15; letter-spacing: -.035em; margin: 0 0 .55em; }
  .guide-section { border-top: 1px solid #cfe8e4; padding: clamp(26px, 5vw, 50px) 0; }
  .guide-section a { color: #105e56; font-weight: 700; text-underline-offset: .24em; }
  .passage-link {
    display:flex; justify-content:space-between; align-items:center; gap:12px;
    min-height:48px; box-sizing:border-box; padding:.5rem 0; color:#105e56;
    font-weight:700; cursor:pointer; list-style:none;
  }
  summary { list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .passages li { padding:0; }
  .read-passage, .hide-passage { background:#41cfc1; color:#fff; text-shadow:0 1px 2px #06423c, 0 0 2px #06423c; border-radius:7px; padding:.25rem .65rem; }
  .hide-passage, .passage[open] .read-passage { display:none; }
  .passage[open] .hide-passage { display:inline; }
  .translation { color:#11675e; font-weight:700; }
  .verse-text { white-space:pre-wrap; font-size:1.12rem; overflow-wrap:anywhere; }
  :focus-visible { outline: 3px solid #087970; outline-offset: 3px; }
  .bulletin-banners { display:grid; gap:14px; margin:18px 0; }
  .bulletin-banners a { display:block; }
  .bulletin-banners img { display:block; width:100%; height:auto; border-radius:8px; }
  .announcements { margin: 14px 0; }
  .announcement { display:flex; align-items:center; gap:clamp(12px,3vw,28px); padding:18px 0; border-bottom:1px solid #deeeeb; }
  .announcement img { width:clamp(90px,25vw,196px); aspect-ratio:4/3; object-fit:contain; background:#edfafa; border-radius:8px; }
  .announcement-body { min-width:0; }
  .announcement h3 { margin: 0; font-size: clamp(1.08rem, 3vw, 1.38rem); line-height: 1.25; }
  .announcement p { margin: .35rem 0; }
  .action { display:inline-flex; align-items:center; min-height:44px; }
  #sunday-live-player :global(iframe) { display:block; width:100%; aspect-ratio:16/9; border:0; border-radius:8px; background:#101010; }
  #archive-video { display:block; width:100%; aspect-ratio:16/9; background:#101010; border-radius:8px; }
  #archive-select { width:100%; min-height:48px; font:inherit; padding:8px 12px; border:1px solid #24867d; border-radius:8px; color:#101010; background:#e5f8f6; }
  .live-badge { display:inline-block; border-radius:999px; color:#fff; background:#b42318; padding:.25rem .7rem; }
  .live-badge::before { content:'● '; }
  #archive-playing { margin:.5rem 0; }
  .calendar-agenda { display:block; width:100%; height:540px; border:1px solid #cfe8e4; border-radius:10px; box-sizing:border-box; }
  .bulletin-text { white-space:pre-line; }
  summary { cursor:pointer; color:#11655d; font-weight:700; padding:.65rem 0; }
  ul { list-style:none; padding:0; }
  li { border-bottom:1px solid #deeeeb; padding:12px 0; }
  li p { margin:.2rem 0; }
  nav {
    position:fixed; z-index:1; bottom:0; inset-inline:0; display:flex; justify-content:center;
    background:#41cfc1; border-top:1px solid #24867d; padding-bottom:env(safe-area-inset-bottom);
  }
  nav a {
    color:#101010; display:grid; place-content:center; min-height:56px;
    padding:0 clamp(6px,2vw,21px); font-weight:650; font-size:clamp(.72rem,2.8vw,.9rem); text-decoration:none;
  }
  nav a:hover, nav a:focus-visible { background:#b3efe9; color:#101010; }
  .scripture-credit { border-top:1px solid #cfe8e4; padding:14px 0 22px; color:#475654; }
  #install-reminder {
    position:fixed; z-index:2; bottom:calc(66px + env(safe-area-inset-bottom));
    inset-inline-end:12px; box-shadow:0 4px 18px #0003; border-radius:9px;
  }
  [data-install], #install-help button {
    font:inherit; font-weight:700; min-height:44px; padding:6px 14px;
    border:1px solid #105e56; border-radius:9px; color:#101010; background:#41cfc1; cursor:pointer;
  }
  #install-help { width:min(400px,calc(100% - 64px)); border:0; border-radius:14px; padding:22px; }
  #install-help::backdrop { background:#0008; }
</style>
