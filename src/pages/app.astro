---
import { getCollection, getEntry } from 'astro:content';
import { loadCalendarEvents } from '../lib/sunday-agenda.mjs';
import sunday from '../content/sunday/current.json';
import calendarSnapshot from '../content/sunday/calendar-snapshot.json';
import bulletin from '../../public/bulletin/current.json';

function httpsLink(value: string, fallback: string) {
  try {
    const url = new URL(value);
    return url.protocol === 'https:' ? url.href : fallback;
  } catch {
    return fallback;
  }
}
type Announcement = {
  title: string;
  text?: string;
  image?: string;
  imageAlt?: string;
  buttonLabel?: string;
  buttonUrl?: string;
};
const announcements = (bulletin.announcements ?? []) as Announcement[];
const weeklyMeal = (await getEntry('meal', 'meal'))?.data;
const siteOrigin = 'https://irvingcollege.church';
function bulletinLink(value?: string) {
  if (!value?.trim()) return '';
  try {
    const raw = value.trim();
    const input = raw.startsWith('images/uploads/') ? '/' + raw : raw;
    const url = input.startsWith('/') ? new URL(input, siteOrigin) : new URL(input);
    if (url.protocol !== 'https:' || (input.startsWith('/') && url.origin !== siteOrigin)) return '';
    return url.origin === siteOrigin ? url.pathname + url.search + url.hash : url.href;
  } catch {
    return '';
  }
}
const banners = (bulletin.banners ?? []).map((banner: { image: string; description: string; url?: string }) => ({
  image: bulletinLink(banner.image),
  description: banner.description,
  url: bulletinLink(banner.url),
})).filter(banner => banner.image);
const calendarEvents = await loadCalendarEvents(sunday.calendarUrl);
const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'America/Chicago' }).format(new Date());
const endDate = new Date(today + 'T00:00:00Z');
endDate.setUTCDate(endDate.getUTCDate() + 42);
const end = endDate.toISOString().slice(0, 10);
const fallbackEvents = calendarSnapshot.length ? calendarSnapshot : (await getCollection('events'))
  .map(({ data }) => ({ ...data, date: data.date.toISOString().slice(0, 10) }));
const events = (calendarEvents ?? fallbackEvents)
  .filter(({ date }) => date >= today && date <= end)
  .sort((a, b) => a.date.localeCompare(b.date));
const eventDateFormat = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const sermonTitle = sunday.title?.trim().replace(/^This Sunday[’']s Message\s*(?:[-–—:]\s*)?/i, '') || '';
const scriptures = (sunday.scriptures ?? []) as { reference: string; text: string; translation?: string }[];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#41cfc1" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="apple-touch-icon" href="/images/sunday-icon-square-256.png" />
  <link rel="icon" href="/images/sunday-icon-square-256.png" />
  <link rel="manifest" href="/sunday.webmanifest" />
  <title>This Sunday | Irving College Baptist Church</title>
</head>
<body>
  <header>
    <a href="/" class="church-wordmark" aria-label="Irving College Baptist Church home">
      <picture>
        <source media="(max-width: 600px)" srcset="/images/sunday-header-mobile.png" width="1000" height="225" />
        <img src="/images/sunday-header.png?v=3" alt="Irving College Baptist Church" width="1560" height="225" fetchpriority="high" decoding="sync" />
      </picture>
    </a>
    <button id="signup-button" type="button" aria-label="Sign up" title="Sign up" aria-haspopup="dialog">
      <svg aria-hidden="true" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5H5a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-3"/><rect x="8" y="2" width="8" height="5" rx="1.5"/><path d="m8 12 2 2 5-5M8 18h8"/></svg>
    </button>
  </header>
  <div class="cover">
    <img src="/images/hero/church-front.jpg" alt="Irving College Baptist Church" width="1672" height="941" fetchpriority="high" />
  </div>
  <main>
    <section id="message" class="hero">

      <h1>This Sunday’s Message</h1>
      {sermonTitle && <p class="sermon-title">{sermonTitle}</p>}
    </section>
    <section id="scripture" class="guide-section">
      <h2>Scripture</h2>
      {scriptures.length ? <ul class="passages">
        {scriptures.map((passage, index) => <li>
          <button type="button" class="passage-link" data-passage-dialog={`passage-dialog-${index}`} aria-haspopup="dialog">
            <span>{passage.reference}</span>
            <span class="read-passage">Read</span>
          </button>
          <dialog class="scripture-dialog" id={`passage-dialog-${index}`} aria-labelledby={`passage-title-${index}`}>
            <div class="scripture-dialog-header">
              <h2 id={`passage-title-${index}`}>{passage.reference}</h2>
              <form method="dialog"><button class="read-passage" autofocus>Close</button></form>
            </div>
            <p class="translation">{passage.translation?.trim() || "CSB"}</p>
            <p class="verse-text">{passage.text}</p>
          </dialog>
        </li>)}
      </ul> : <p>Scripture passages will appear here when they’re published.</p>}
    </section>
    <section id="bulletin" class="guide-section">
      <h2>Weekly Bulletin</h2>
      {bulletin.text?.trim() && bulletin.text.trim().split(/\r?\n\s*\r?\n/).map(paragraph =>
        <p class="bulletin-text">{paragraph}</p>
      )}
      {banners.length > 0 && <div class="bulletin-banners">
        {banners.map(banner => banner.url ? (
          <a href={banner.url}><img src={banner.image} alt={banner.description} width="1560" height="450" loading="lazy" decoding="async" /></a>
        ) : <img src={banner.image} alt={banner.description} width="1560" height="450" loading="lazy" decoding="async" />)}
      </div>}
      {announcements.length > 0 && <div class="announcements">
        {announcements.map(item => {
          const image = bulletinLink(item.image);
          const action = bulletinLink(item.buttonUrl);
          return <article class="announcement">
            {image && <img src={image} alt={item.imageAlt ?? ''} loading="lazy" decoding="async" />}
            <div class="announcement-body">
              <h3>{item.title}</h3>
              {item.text && <p class="bulletin-text">{item.text}</p>}
              {action && <a class="action" href={action}>{item.buttonLabel?.trim() || 'View details'}</a>}
            </div>
          </article>;
        })}
      </div>}
      {!bulletin.text?.trim() && !announcements.length && !banners.length && <p>The weekly bulletin will appear here when it’s published.</p>}
    </section>
    <section id="events" class="guide-section">
      <h2>Events</h2>
      <div id="event-list">
        {events.length ? <ul>{events.map(event => <li class="calendar-announcement">
          <h3>{event.title}</h3>
          <p class="event-details">{[eventDateFormat.format(new Date(event.date + 'T00:00:00Z')), event.time].filter(Boolean).join(' · ')}</p>
          {event.location && <p class="event-details">{event.location}</p>}
          {event.description && <p class="event-description">{event.description}</p>}
        </li>)}</ul> : <p>No events are scheduled in the next six weeks.</p>}
      </div>
    </section>
    <section id="give" class="guide-section">
      <h2>Give</h2>
      <div class="giving-links">
        {httpsLink(sunday.planningCenterGivingUrl, '') && <a href={httpsLink(sunday.planningCenterGivingUrl, '')} aria-label="Give with Church Center"><img src="/images/church-center-logo-white.svg" width="164" alt=""></a>}
        <a href="https://venmo.com/irvingcollege" aria-label="Give with Venmo"><img src="/images/venmo-logo-white.png" width="92" alt=""></a>
      </div>
      {httpsLink(sunday.givingUrl, '') && <p><a href={httpsLink(sunday.givingUrl, '')}>Give with Tithe.ly</a></p>}
    </section>
    <section id="watch" class="guide-section">
      <h2>Watch</h2>
      <div id="sunday-live" hidden>
        <p role="status"><strong class="live-badge">Live now</strong></p>
        <div id="sunday-live-player"></div>
      </div>
      <h3 id="archive-title">Latest Sermon</h3>
      <p id="archive-status" role="status">Loading latest sermon…</p>
      <div id="archive-player" hidden><h4 id="archive-playing"></h4><video id="archive-video" controls playsinline preload="none"></video></div>
    </section>
    {scriptures.some(passage => !passage.translation?.trim() || /^(csb|christian standard bible)$/i.test(passage.translation.trim())) && <footer class="scripture-credit"><small>Scripture quotations marked CSB are from the Christian Standard Bible®, copyright © 2017 by Holman Bible Publishers. Used by permission.</small></footer>}
    <p id="install-link" hidden><button type="button" data-install>Add to Home Screen</button></p>
  </main>
  <aside id="install-reminder" hidden aria-label="Add the Sunday app to your phone">
    <button type="button" data-install>Add to Home Screen</button>
  </aside>
  <dialog id="signup-menu" aria-labelledby="signup-title">
    <div class="signup-heading">
      <h2 id="signup-title">Sign Up</h2>
      <form method="dialog"><button class="signup-close" aria-label="Close sign-up menu">Close</button></form>
    </div>
    <details class="signup-option" id="meal-signup-option">
      <summary class="signup-choice">Wednesday Night Supper <span aria-hidden="true">›</span></summary>
      <div class="signup-form">
        <p id="meal-rsvp-date" aria-live="polite">Loading this week’s supper…</p>
        <p id="meal-rsvp-deadline"></p>
        {weeklyMeal?.showMenu && <div class="signup-meal-menu">
          <strong>{weeklyMeal.title}</strong>
          {weeklyMeal.menu && <p>{weeklyMeal.menu}</p>}
          {weeklyMeal.note && <p>{weeklyMeal.note}</p>}
        </div>}
        <form id="meal-rsvp-form" class="signup-form">
          <input type="hidden" name="eventDate">
          <fieldset class="signup-meal-choices">
            <legend>Will you be eating with us?</legend>
            <label><input type="radio" name="attending" value="yes" required> Yes, we’ll be there</label>
            <label><input type="radio" name="attending" value="no" required> No, not this week</label>
          </fieldset>
          <label id="meal-rsvp-number" hidden>How many people will be eating? <input name="numberEating" type="number" min="1" max="30" inputmode="numeric"></label>
          <label>First name <input name="firstName" autocomplete="given-name" maxlength="50" required></label>
          <label>Last name <input name="lastName" autocomplete="family-name" maxlength="50" required></label>
          <small>Submitting again with the same first and last name updates your response.</small>
          <button type="submit" disabled>Submit RSVP</button>
        </form>
        <p id="meal-rsvp-status" class="signup-status" role="status"></p>
        <button type="button" id="meal-rsvp-change" hidden>Change my response</button>
      </div>
    </details>
    <details class="signup-option">
      <summary class="signup-choice">Ministry Opportunities <span aria-hidden="true">›</span></summary>
      <form class="signup-form" data-signup-type="ministry">
        <label>Your name <input name="name" autocomplete="name" required maxlength="100"></label>
        <label>Phone or email <input name="contact" required maxlength="160"></label>
        <label>Where would you like to serve? <textarea name="interest" required maxlength="1000" rows="3"></textarea></label>
        <label class="signup-trap" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
        <button type="submit">Submit interest</button>
        <p class="signup-status" role="status"></p>
      </form>
    </details>
    <details class="signup-option">
      <summary class="signup-choice">Reserve Fellowship Hall <span aria-hidden="true">›</span></summary>
      <form class="signup-form" data-signup-type="hall">
        <p>Send a reservation request. Church leadership will confirm availability with you.</p>
        <label>Your name <input name="name" autocomplete="name" required maxlength="100"></label>
        <label>Phone or email <input name="contact" required maxlength="160"></label>
        <label>Requested date <input type="date" name="date" required></label>
        <div class="signup-times">
          <label>Start time <input type="time" name="start" required></label>
          <label>End time <input type="time" name="end" required></label>
        </div>
        <label>Purpose of reservation <textarea name="purpose" required maxlength="1000" rows="3"></textarea></label>
        <label class="signup-trap" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
        <button type="submit">Request reservation</button>
        <p class="signup-status" role="status"></p>
      </form>
    </details>
  </dialog>
  <dialog id="install-help" aria-labelledby="install-title">
    <h2 id="install-title">Add to Home Screen</h2>
    <p id="install-steps"></p>
    <form method="dialog"><button autofocus>Close</button></form>
  </dialog>
  <nav aria-label="Sunday app"><a href="#message">Message</a><a href="#scripture">Scripture</a><a href="#bulletin">Bulletin</a><a href="#events">Events</a><a href="#give">Give</a><a href="#watch"><span id="watch-nav-label">Watch</span></a></nav>
</body>
</html>
<script>
  const archiveStatus = document.getElementById('archive-status')!;
  const archivePlayer = document.getElementById('archive-player')!;
  const archiveVideo = document.querySelector<HTMLVideoElement>('#archive-video')!;
  const archivePlaying = document.getElementById('archive-playing')!;
  let archiveKey = '';
  function renderArchive(value: unknown) {
    const items = Array.isArray(value) ? value.filter(s => s && typeof s.date === 'string' && typeof s.url === 'string' && s.url.startsWith('https://live.irvingcollege.church/sermons/')) : [];
    const sermon = items.sort((a, b) => b.date.localeCompare(a.date))[0];
    if (!sermon) {
      if (!archiveKey) archiveStatus.textContent = 'No recording available right now.';
      return;
    }
    const key = JSON.stringify(sermon);
    if (key === archiveKey) return;
    archiveKey = key;
    const date = new Date(sermon.date + 'T12:00:00Z');
    const label = Number.isNaN(date.getTime()) ? sermon.date : date.toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric', timeZone:'UTC'});
    const title = typeof sermon.title === 'string' && sermon.title.trim() ? sermon.title : label;
    archivePlaying.textContent = title.includes(label) ? title : title + ' · ' + label;
    if (archiveVideo.getAttribute('src') !== sermon.url) archiveVideo.src = sermon.url;
    archivePlayer.hidden = false;
    archiveStatus.textContent = '';
  }
  archiveVideo.addEventListener('error', () => {
    archiveStatus.textContent = 'This recording couldn’t play. Please try again shortly.';
  });
  const watchLabel = document.getElementById('watch-nav-label');
  const live = document.getElementById('sunday-live');
  const player = document.getElementById('sunday-live-player');
  if (live && player) {
    let checking = false;
    const refresh = async () => {
      if (checking) return;
      checking = true;
      try {
        const response = await fetch('/.netlify/functions/worship-feed', { cache: 'no-store' });
        if (!response.ok) throw new Error('Feed unavailable');
        const { online, sermons } = await response.json();
        renderArchive(sermons);
        if (online === true && live.hidden) {
          const frame = document.createElement('iframe');
          frame.src = 'https://live.irvingcollege.church/embed/video?autoplay=off';
          frame.title = 'Irving College Baptist Church livestream';
          frame.referrerPolicy = 'origin';
          frame.allow = 'fullscreen; picture-in-picture';
          frame.allowFullscreen = true;
          player.replaceChildren(frame);
          live.hidden = false;
          if (watchLabel) watchLabel.textContent = "● Live";
        } else if (online === false && !live.hidden) {
          live.hidden = true;
          if (watchLabel) watchLabel.textContent = "Watch";
          player.replaceChildren();
        }
      } catch {
        // Keep any playing stream visible during a temporary connection failure.
        if (!archiveKey) archiveStatus.textContent = 'Latest sermon temporarily unavailable. Please try again shortly.';
      } finally {
        checking = false;
      }
    };
    void refresh();
    window.setInterval(refresh, 30000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refresh();
    });
  }

  type InstallPrompt = Event & {
    prompt: () => Promise<{ outcome: 'accepted' | 'dismissed' }>;
  };
  const reminder = document.getElementById('install-reminder');
  const installLink = document.getElementById('install-link');
  const help = document.querySelector<HTMLDialogElement>('#install-help');
  const steps = document.getElementById('install-steps');
  const ios = /iPhone|iPad|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const android = /Android/.test(navigator.userAgent);
  const installed = () => window.matchMedia('(display-mode: standalone)').matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;
  let prompt: InstallPrompt | undefined;
  function hideInstall() {
    if (reminder) reminder.hidden = true;
    if (installLink) installLink.hidden = true;
  }
  window.addEventListener('appinstalled',hideInstall);
  window.addEventListener('beforeinstallprompt', event => {
    if ((!ios && !android) || installed()) return;
    event.preventDefault();
    prompt = event as InstallPrompt;
  });
  if ((ios || android) && !installed() && reminder && installLink) {
    reminder.hidden = false;
    installLink.hidden = false;
    window.setTimeout(() => {
      if (reminder.contains(document.activeElement)) {
        reminder.addEventListener('focusout', () => { reminder.hidden = true; }, {once:true});
      } else {
        reminder.hidden = true;
      }
    },3000);
    for (const button of document.querySelectorAll('[data-install]')) {
      button.addEventListener('click', async () => {
        if (prompt) {
          const current = prompt;
          prompt = undefined;
          try {
            const result = await current.prompt();
            if (result.outcome === 'accepted') hideInstall();
            return;
          } catch {
            // Show manual steps if the browser declines to open its install prompt.
          }
        }
        if (!help || !steps || help.open) return;
        steps.textContent = ios
          ? 'Open this page in Safari. Tap Share, then Add to Home Screen. Turn on Open as Web App if shown, then tap Add.'
          : 'Open this page in Chrome. Tap the three-dot menu, then Add to home screen or Install app.';
        help.showModal();
      });
    }
  }
</script>
<script is:inline id="scripture-dialog-script">
  document.querySelectorAll('[data-passage-dialog]').forEach(button => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.passageDialog);
      if (dialog && !dialog.open) {
        dialog.showModal();
        dialog.scrollTop = 0;
      }
    });
  });
  document.querySelectorAll('.scripture-dialog').forEach(dialog => {
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right ||
          event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  });
</script>
<script is:inline>
  const signupDialog = document.getElementById('signup-menu');
  document.getElementById('signup-button').addEventListener('click', () => {
    signupDialog.showModal();
    if (mealOption.open) void loadMealWeek();
  });
  const signupOptions = signupDialog.querySelectorAll('.signup-option');
  signupOptions.forEach(option => {
    option.addEventListener('toggle', () => {
      if (option.open) signupOptions.forEach(other => { if (other !== option) other.open = false; });
    });
  });
  const mealOption = document.getElementById('meal-signup-option');
  const mealForm = document.getElementById('meal-rsvp-form');
  const mealSubmit = mealForm.querySelector('button[type="submit"]');
  const mealStatus = document.getElementById('meal-rsvp-status');
  const mealNumber = document.getElementById('meal-rsvp-number');
  const mealChange = document.getElementById('meal-rsvp-change');
  let mealLoading = false;
  let mealSaving = false;
  let mealReady = false;

  async function loadMealWeek() {
    if (mealLoading || mealSaving) return;
    mealLoading = true;
    mealReady = false;
    mealSubmit.disabled = true;
    try {
      const response = await fetch('/.netlify/functions/meal-rsvp?action=info', { cache: 'no-store' });
      if (!response.ok) throw new Error();
      const week = await response.json();
      if (mealForm.elements.eventDate.value && mealForm.elements.eventDate.value !== week.eventDate) {
        mealForm.hidden = false;
        mealChange.hidden = true;
        mealStatus.textContent = '';
      }
      mealForm.elements.eventDate.value = week.eventDate;
      document.getElementById('meal-rsvp-date').textContent = 'Wednesday, ' + week.eventLabel + ' at 5:30 PM';
      document.getElementById('meal-rsvp-deadline').textContent = 'Please respond by ' + week.deadlineLabel + '.';
      mealReady = true;
    } catch {
      mealStatus.textContent = 'Unable to load this week’s RSVP. Close and reopen supper to try again.';
    } finally {
      mealLoading = false;
      mealSubmit.disabled = !mealReady || mealSaving;
    }
  }
  mealOption.addEventListener('toggle', () => { if (mealOption.open) void loadMealWeek(); });
  mealForm.addEventListener('change', event => {
    if (event.target.name !== 'attending') return;
    const attending = mealForm.elements.attending.value === 'yes';
    mealNumber.hidden = !attending;
    mealForm.elements.numberEating.required = attending;
    if (!attending) mealForm.elements.numberEating.value = '';
  });
  mealForm.addEventListener('submit', async event => {
    event.preventDefault();
    if (!mealReady || mealSaving) return;
    mealSaving = true;
    mealSubmit.disabled = true;
    mealStatus.textContent = 'Submitting your RSVP…';
    let refresh = false;
    try {
      const response = await fetch('/.netlify/functions/meal-rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(mealForm)))
      });
      const result = await response.json();
      if (!response.ok) {
        refresh = result.refresh === true;
        throw new Error(result.error || 'Unable to save your RSVP.');
      }
      mealForm.hidden = true;
      mealChange.hidden = false;
      mealStatus.textContent = result.message;
    } catch (error) {
      mealStatus.textContent = error.message || 'Unable to save your RSVP. Please try again.';
    } finally {
      mealSaving = false;
      if (refresh) void loadMealWeek();
      else mealSubmit.disabled = !mealReady;
    }
  });
  mealChange.addEventListener('click', () => {
    mealForm.hidden = false;
    mealChange.hidden = true;
    mealStatus.textContent = '';
    void loadMealWeek();
  });
  // The weekly bulletin's supper link opens the same RSVP without leaving the app.
  document.querySelectorAll('#bulletin a[href]').forEach(link => {
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || !/^\/meal\/?$/.test(url.pathname)) return;
    link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      signupDialog.showModal();
      mealOption.open = true;
      void loadMealWeek();
    });
  });
  signupDialog.querySelectorAll('[data-signup-type]').forEach(form => {
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      const status = form.querySelector('.signup-status');
      button.disabled = true;
      status.textContent = 'Submitting your request…';
      try {
        const response = await fetch('/.netlify/functions/signup-requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), type: form.dataset.signupType })
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Unable to submit.');
        form.reset();
        status.textContent = form.dataset.signupType === 'hall'
          ? 'Your reservation request was received. Please wait for confirmation.'
          : 'Thank you! Your ministry interest was received.';
      } catch (error) {
        status.textContent = error.message || 'Unable to submit. Please try again.';
      } finally {
        button.disabled = false;
      }
    });
  });
  // Retire existing subscriptions from the app's dedicated notification worker.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistration('/push/onesignal/').then(async registration => {
