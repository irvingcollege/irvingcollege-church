---
import { getCollection } from "astro:content";

import Section from "./Section.astro";
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";

const allEvents = await getCollection("events");

const today = new Date();
today.setHours(0, 0, 0, 0);

const events = allEvents
  .filter((event) => event.data.date >= today)
  .sort(
    (a, b) =>
      a.data.date.getTime() - b.data.date.getTime()
  )
  .slice(0, 3);

const formatDate = (date: Date) => ({
  month: new Intl.DateTimeFormat("en-US", {
    month: "short",
  }).format(date),
  day: new Intl.DateTimeFormat("en-US", {
    day: "numeric",
  }).format(date),
});
---

<Section id="events" soft>
  <Container>
    <SectionHeading
      eyebrow="Upcoming Events"
      title="There’s Always Something Happening"
      text="Join us for upcoming opportunities to worship, connect, and serve."
    />

    {
      events.length > 0 ? (
        <div class="events-grid">
          {events.map((event) => {
            const date = formatDate(event.data.date);

            return (
              <article class="event-card">
                {event.data.image && (
                  <div class="event-image">
                    <img
                      src={event.data.image}
                      alt={event.data.title}
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="event-content">
                  <div class="event-date" aria-label={`${date.month} ${date.day}`}>
                    <span class="month">{date.month}</span>
                    <span class="day">{date.day}</span>
                  </div>

                  <div class="event-details">
                    <h3>{event.data.title}</h3>

                    <p class="event-meta">
                      {event.data.time}
                      {event.data.location && ` · ${event.data.location}`}
                    </p>

                    <p>{event.data.description}</p>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="empty-events">
          <p class="empty-eyebrow">Nothing Scheduled Yet</p>
          <h3>Check Back Soon</h3>
          <p>
            We’re always planning new opportunities to worship, connect, and
            serve. You’re also welcome to join us this Sunday at 10:30 AM.
          </p>

          <a class="visit-button" href="#visit">
            Plan Your Visit
            <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </Container>
</Section>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

.event-card {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.event-card:hover {
  box-shadow: 0 1.5rem 3.5rem rgba(20, 45, 35, 0.13);
  transform: translateY(-5px);
}

.event-image {
  overflow: hidden;
}

.event-image img {
  transition: transform 0.4s ease;
}

.event-card:hover .event-image img {
  transform: scale(1.04);
}

.empty-events {
  max-width: 760px;
  margin: 3rem auto 0;
  padding: clamp(2rem, 6vw, 4rem);
  text-align: center;
  background: #ffffff;
  border: 1px solid rgba(20, 45, 35, 0.1);
  border-radius: 1.5rem;
  box-shadow: 0 1rem 2.5rem rgba(20, 45, 35, 0.08);
}

.empty-eyebrow {
  margin: 0 0 0.75rem;
  color: var(--color-primary);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.empty-events h3 {
  margin: 0 0 1rem;
  font-size: clamp(1.75rem, 4vw, 2.5rem);
}

.empty-events > p:not(.empty-eyebrow) {
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.7;
}

.visit-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  min-height: 52px;
  margin-top: 1.5rem;
  padding: 0.9rem 1.5rem;
  color: #ffffff;
  background: var(--color-primary);
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  transition:
    background-color 0.2s ease,
    transform 0.2s ease;
}

.visit-button:hover,
.visit-button:focus-visible {
  color: #ffffff;
  background: var(--color-primary-dark);
  transform: translateY(-2px);
}

  .event-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(20, 45, 35, 0.1);
    border-radius: 1.25rem;
    box-shadow: 0 1rem 2.5rem rgba(20, 45, 35, 0.08);
  }

  .event-image img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .event-content {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
  }

  .event-date {
    flex: 0 0 3.5rem;
    text-align: center;
  }

  .month {
    display: block;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .day {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-details h3 {
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }

  .event-meta {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .event-details p:not(.event-meta) {
    margin-bottom: 1.25rem;
  }

  @media (max-width: 950px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .event-card {
      display: grid;
      grid-template-columns: minmax(220px, 0.7fr) 1fr;
    }

    .event-image img {
      height: 100%;
      min-height: 250px;
    }
  }

  @media (max-width: 650px) {
    .event-card {
      display: block;
    }

    .event-image img {
      height: 210px;
      min-height: 0;
    }
  }
</style>