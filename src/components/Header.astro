<header class="site-header" data-header>
  <div class="header-inner">
    <a
      class="logo"
      href="#top"
      aria-label="Irving College Baptist Church home"
    >
      <img
        src="/images/1080logo.jpg"
        alt="Irving College Baptist Church"
        width="1920"
        height="1080"
      />
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-button
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav
      id="site-navigation"
      class="navigation"
      aria-label="Primary navigation"
      data-navigation
    >
      <a href="#about">About</a>
      <a href="#ministries">Ministries</a>
      <a href="#sermon">Sermons</a>
      <a href="#events">Events</a>
      <a href="#giving">Give</a>

      <a class="visit-link" href="#visit">
        Plan Your Visit
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector("[data-menu-button]");
  const navigation = document.querySelector("[data-navigation]");

  const closeMenu = () => {
    menuButton?.setAttribute("aria-expanded", "false");
    navigation?.classList.remove("open");
    document.body.classList.remove("menu-open");
  };

  menuButton?.addEventListener("click", () => {
    const isOpen =
      menuButton.getAttribute("aria-expanded") === "true";

    menuButton.setAttribute("aria-expanded", String(!isOpen));
    navigation?.classList.toggle("open", !isOpen);
    document.body.classList.toggle("menu-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid rgba(20, 45, 35, 0.08);
    box-shadow: 0 8px 32px rgba(20, 45, 35, 0.07);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 3rem), 1400px);
    min-height: 88px;
    margin-inline: auto;
  }

  .logo {
    position: relative;
    z-index: 1002;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    display: block;
    width: auto;
    height: 68px;
    object-fit: contain;
  }

  /* DESKTOP NAVIGATION */
  .navigation {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.3vw, 2.25rem);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .navigation a {
    position: relative;
    color: var(--color-text);
    text-decoration: none;
    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .navigation a:not(.visit-link)::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .navigation a:not(.visit-link):hover,
  .navigation a:not(.visit-link):focus-visible {
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .navigation a:not(.visit-link):hover::after,
  .navigation a:not(.visit-link):focus-visible::after {
    transform: scaleX(1);
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.75rem 1.4rem;
    color: #ffffff !important;
    background: var(--color-primary);
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(49, 92, 58, 0.2);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .visit-link:hover,
  .visit-link:focus-visible {
    color: #ffffff !important;
    background: var(--color-primary-dark);
    box-shadow: 0 12px 26px rgba(49, 92, 58, 0.3);
    transform: translateY(-2px);
  }

  .menu-button {
    position: relative;
    z-index: 1002;
    display: none;
    width: 3rem;
    height: 3rem;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    width: 1.55rem;
    height: 2px;
    margin: 5px auto;
    background: currentColor;
    border-radius: 999px;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .menu-button:focus-visible {
    outline: 3px solid rgba(49, 92, 58, 0.3);
    outline-offset: 2px;
  }

  /* MOBILE */
  @media (max-width: 900px) {
    .header-inner {
      width: min(calc(100% - 2rem), 1400px);
      min-height: 78px;
    }

    .logo img {
      height: 60px;
    }

    .menu-button {
      display: block;
    }

    .menu-button[aria-expanded="true"] {
      color: var(--color-primary-dark);
    }

    .navigation {
      position: fixed;
      z-index: 1001;

      /* Keeps the actual header white */
      top: 78px;
      right: 0;
      bottom: 0;
      left: 0;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 1.5rem;
      padding: 2rem;

      /* Dims the page behind the menu */
      background: rgba(20, 45, 35, 0.32);
