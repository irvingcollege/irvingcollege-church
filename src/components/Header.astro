      transform: translateY(-0.75rem);

      transition:
        opacity 180ms ease,
        visibility 180ms ease,
        transform 180ms ease;
    }

    /* WHITE MENU CARD */
    .navigation::before {
      content: "";
      position: absolute;
      z-index: 0;

      width: min(86vw, 360px);
      height: 410px;

      background: #ffffff;
      border: 1px solid rgba(20, 45, 35, 0.08);
      border-radius: 1.5rem;

      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    }

    .navigation.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .navigation a {
      z-index: 1;
      color: var(--color-text);
    }

    /* REMOVE THE LINES UNDER MOBILE LINKS */
    .navigation a:not(.visit-link)::after {
      display: none;
    }

    .navigation a:not(.visit-link):hover,
    .navigation a:not(.visit-link):focus-visible {
      color: var(--color-primary);
      transform: none;
    }

    .visit-link {
      z-index: 1;
      margin-top: 0.4rem;
      padding-inline: 1.75rem;
      color: #ffffff !important;
      background: var(--color-primary);
      box-shadow: 0 8px 20px rgba(49, 92, 58, 0.2);
    }

    .visit-link:hover,
    .visit-link:focus-visible {
      color: #ffffff !important;
      background: var(--color-primary-dark);
    }

    .menu-button[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-button[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-button[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
