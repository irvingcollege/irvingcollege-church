  }

  @media (max-width: 480px) {
    .logo img {
      height: 54px;
    }

    .navigation::before {
      width: min(90vw, 340px);
      height: 390px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation,
    .navigation a,
    .visit-link,
    .menu-button span {
      transition: none;
    }
  }
</style>