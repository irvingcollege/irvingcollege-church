---
interface Props {
  churchName: string;
  address: string;
  cityStateZip: string;
  phone?: string;
  email?: string;
}

const {
  churchName,
  address,
  cityStateZip,
  phone,
  email,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
  

    <div class="footer-column">
      <h2>Visit Us</h2>

      <address>
        {address}<br />
        {cityStateZip}
      </address>

      <a
        href="https://www.google.com/maps/search/?api=1&query=8931+Beersheba+Highway+McMinnville+TN+37110"
        target="_blank"
        rel="noopener noreferrer"
      >
        Get Directions
      </a>
    </div>

    <div class="footer-column">
      <h2>Service Times</h2>

      <p>
        Sunday School <br />9:30 AM<br />
        Sunday Worship<br />10:30 AM<br />
        Wednesday Meal<br />5:30 PM<br />
        Wednesday Bible Study<br />6:30 PM
      </p>
    </div>

<div class="footer-column">
  <h2>Quick Links</h2>

  <a href="#visit">Plan Your Visit</a>
  <a href="#sermon">Latest Sermon</a>
  <a href="#events">Upcoming Events</a>
  <a href="mailto:icbcnextsteps@gmail.com">Contact</a>
</div>

    <div class="footer-column">
      <h2>Connect</h2>

      <a
        href="https://www.youtube.com/@irvingcollege.church"
        target="_blank"
        rel="noopener noreferrer"
      >
        YouTube
      </a>
      <a
        href="https://www.facebook.com/irvingcollege.church"
        target="_blank"
        rel="noopener noreferrer"
      >
        Facebook
      </a>
      <a
        href="https://www.facebook.com/groups/irvingcollege.church"
        target="_blank"
        rel="noopener noreferrer"
      >
        Facebook Group
      </a>
      <a
        href="https://www.instagram.com/irvingcollege.church"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} {churchName}. Serving Warren County and sharing the hope of Jesus Christ.</p>
  </div>
</footer>

<style>
  .footer {
    color: rgba(255, 255, 255, 0.82);
    background: var(--color-primary-dark);
  }

  .footer-inner {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 220px));
  justify-content: center;
  column-gap: 3rem;
  row-gap: 2rem;
  width: min(100% - 2rem, 1200px);
  margin-inline: auto;
  padding: 5.5rem 0 4.5rem;
}

  .footer-logo {
    display: inline-block;
    margin-bottom: 1rem;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
  }

  .footer-about p {
    max-width: 22rem;
  }

  .footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.7rem;
}

  .footer-column h2 {
    margin: 0 0 0.5rem;
    color: #ffffff;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-column p,
  .footer-column address {
    margin: 0;
    color: inherit;
    font-style: normal;
    line-height: 1.8;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    padding: 1.25rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 3.5rem 0;
    }
  }
  .footer a{
    transition:
      color .2s ease,
      transform .2s ease;
}

.footer-column a:hover{
    transform:translateX(4px);
}
</style>