---
import Section from "./Section.astro";
import Container from "./Container.astro";

interface Props {
  eyebrow: string;
  heading: string;
  text: string;
  buttonText: string;
  url: string;
}

const {
  eyebrow,
  heading,
  text,
  buttonText,
  url,
} = Astro.props;
---

<Section id="giving">
  <Container>
    <div class="giving-intro">
      <p class="giving-eyebrow">{eyebrow}</p>

      <h2>{heading}</h2>

      <p class="giving-text">{text}</p>

      <a
        class="give-button"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {buttonText}

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <div class="impact-section">
      <div class="section-intro">
        <p class="section-eyebrow">Ministry Impact</p>
        <h3>Your Giving Supports the Work of the Church</h3>
      </div>

      <div class="impact-grid">
        <article class="impact-card">
          <div class="impact-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="9" cy="7" r="3"></circle>
              <circle cx="17" cy="9" r="2.5"></circle>
              <path d="M3.5 20v-2a5.5 5.5 0 0 1 11 0v2"></path>
              <path d="M14.5 15.5A4.5 4.5 0 0 1 21 19.5V20"></path>
            </svg>
          </div>

          <h4>Kids Ministry</h4>

          <p>
            Helping children discover Jesus in a safe, fun, and
            Christ-centered environment.
          </p>
        </article>

        <article class="impact-card">
          <div class="impact-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"></path>
            </svg>
          </div>

          <h4>Community Outreach</h4>

          <p>
            Meeting practical needs and showing the love of Christ
            throughout Warren County.
          </p>
        </article>

        <article class="impact-card">
          <div class="impact-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v18H7.5A3.5 3.5 0 0 0 4 23Z"></path>
              <path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v18h3.5A3.5 3.5 0 0 1 20 23Z"></path>
            </svg>
          </div>

          <h4>Biblical Teaching</h4>

          <p>
            Supporting faithful preaching and teaching that points
            every generation to Jesus.
          </p>
        </article>

        <article class="impact-card">
          <div class="impact-icon">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
              <path d="M16 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"></path>
              <path d="M2 21v-2a6 6 0 0 1 10-4.5"></path>
              <path d="M22 21v-2a6 6 0 0 0-10-4.5"></path>
              <path d="M9 18h6"></path>
            </svg>
          </div>

          <h4>Discipleship</h4>

          <p>
            Helping people grow through Sunday School, Bible studies,
            fellowship, and Christian community.
          </p>
        </article>
      </div>
    </div>

    <div class="giving-details">
      <div class="faq-section">
        <p class="section-eyebrow">Giving Questions</p>
        <h3>Frequently Asked Questions</h3>

        <div class="faq-list">
          <details>
            <summary>
              <span>Is online giving secure?</span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>

            <p>
              Yes. Your information is encrypted and securely processed
              through our trusted online giving provider.
            </p>
          </details>

          <details>
            <summary>
              <span>Can I give a one-time gift?</span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>

            <p>
              Absolutely. You can make a one-time gift without setting
              up recurring giving.
            </p>
          </details>

          <details>
            <summary>
              <span>Can I set up recurring giving?</span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>

            <p>
              Yes. You can choose a recurring schedule that works best
              for you and update or cancel it at any time.
            </p>
          </details>
        </div>
      </div>

      <aside class="pastor-note">
        <svg
          class="quote-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M9 11H4a6 6 0 0 1 6-6v3a3 3 0 0 0-3 3v1h2v7H3v-8Z"></path>
          <path d="M21 11h-5a6 6 0 0 1 6-6v3a3 3 0 0 0-3 3v1h2v7h-6v-8Z"></path>
        </svg>

        <blockquote>
          Thank you for partnering with what God is doing through Irving
          College Baptist Church. Every gift helps us share the Gospel
          and serve our community.
        </blockquote>

        <p class="pastor-name">&mdash; Pastor Ryan</p>
      </aside>
    </div>
  </Container>
</Section>

<style>
  .giving-intro {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .giving-eyebrow,
  .section-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .giving-intro h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.08;
  }

  .giving-text {
    max-width: 660px;
    margin: 1.25rem auto 0;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .give-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 54px;
    margin-top: 2rem;
    padding: 0.9rem 1.7rem;
    color: #ffffff;
    background: var(--color-primary);
    border-radius: 999px;
    box-shadow: 0 12px 28px rgba(49, 92, 58, 0.24);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .give-button svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .give-button:hover,
  .give-button:focus-visible {
    color: #ffffff;
    background: var(--color-primary-dark);
    box-shadow: 0 16px 34px rgba(49, 92, 58, 0.32);
    transform: translateY(-2px);
  }

  .impact-section {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .section-intro {
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .section-intro h3,
  .faq-section h3 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .impact-card {
    padding: 1.75rem;
    background: #ffffff;
    border: 1px solid rgba(20, 45, 35, 0.09);
    border-radius: 1.4rem;
    box-shadow: 0 12px 32px rgba(20, 45, 35, 0.07);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .impact-card:hover {
    border-color: rgba(49, 92, 58, 0.2);
    box-shadow: 0 20px 44px rgba(20, 45, 35, 0.12);
    transform: translateY(-5px);
  }

  .impact-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    background: rgba(49, 92, 58, 0.09);
    border-radius: 1rem;
  }

  .impact-icon svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .impact-card h4 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
  }

  .impact-card p {
    margin: 0;
    line-height: 1.65;
  }

  .giving-details {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .faq-section,
  .pastor-note {
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
  }

  .faq-section {
    background: var(--color-background-soft);
    border: 1px solid rgba(20, 45, 35, 0.08);
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .faq-list details {
    background: #ffffff;
    border: 1px solid rgba(20, 45, 35, 0.1);
    border-radius: 1rem;
  }

  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary svg {
    flex: 0 0 auto;
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--color-primary);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: transform 0.2s ease;
  }

  .faq-list details[open] summary svg {
    transform: rotate(180deg);
  }

  .faq-list details p {
    margin: 0;
    padding: 0 1.25rem 1.25rem;
    line-height: 1.7;
  }

  .pastor-note {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #ffffff;
    background: var(--color-primary-dark);
    box-shadow: 0 16px 40px rgba(20, 45, 35, 0.15);
  }

  .quote-icon {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1.25rem;
    fill: none;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .pastor-note blockquote {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .pastor-name {
    margin: 1.25rem 0 0;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .impact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .giving-details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .impact-grid {
      grid-template-columns: 1fr;
    }

    .impact-card {
      padding: 1.5rem;
    }

    .give-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .give-button,
    .impact-card,
    .faq-list summary svg {
      transition: none;
    }
  }
</style>