---
import Section from "./Section.astro";
import Container from "./Container.astro";
---

<Section id="sermon" soft>
  <Container>
    <div class="sermon-layout">
      <div class="sermon-video" id="worship-player">
        <div class="player-placeholder">Loading worship video…</div>
      </div>
      <div class="sermon-content">
        <p class="section-eyebrow" id="worship-label">Latest Sermon</p>
        <h2 id="worship-title">Watch Our Latest Service</h2>
        <p class="sermon-description" id="worship-description">
          Watch our latest message and discover the hope found in Jesus Christ.
        </p>
        <p class="sermon-date" id="worship-date"></p>
        <a class="watch-button" id="worship-link" href="https://live.irvingcollege.church" target="_blank" rel="noopener noreferrer">
          View Worship
        </a>
      </div>
    </div>
  </Container>
</Section>

<script>
  type Sermon = { title: string; date: string; url: string };
  type Feed = { online: boolean; liveUrl: string; latestSermon: Sermon | null };
  const player = document.getElementById("worship-player");
  const label = document.getElementById("worship-label");
  const title = document.getElementById("worship-title");
  const description = document.getElementById("worship-description");
  const date = document.getElementById("worship-date");
  const link = document.getElementById("worship-link") as HTMLAnchorElement | null;
  let shown = "";

  function render(feed: Feed) {
    if (!player || !label || !title || !description || !date || !link) return;
    const key = feed.online ? "live" : feed.latestSermon?.url || "none";
    if (shown === key) return;
    shown = key;
    player.replaceChildren();

    if (feed.online) {
      const iframe = document.createElement("iframe");
      iframe.src = "https://live.irvingcollege.church/embed/video";
      iframe.title = "Irving College Baptist Church live worship";
      iframe.allow = "autoplay; fullscreen; picture-in-picture";
      iframe.allowFullscreen = true;
      player.append(iframe);
      label.textContent = "● LIVE NOW";
      title.textContent = "Watch Live Worship";
      description.textContent = "Join us live at Irving College Baptist Church.";
      date.textContent = "";
      link.href = "https://live.irvingcollege.church";
      link.textContent = "Open Live Stream";
    } else if (feed.latestSermon) {
      const sermon = feed.latestSermon;
      const video = document.createElement("video");
      video.src = sermon.url;
      video.controls = true;
      video.preload = "metadata";
      video.playsInline = true;
      player.append(video);
      label.textContent = "Latest Sermon";
      title.textContent = sermon.title;
      description.textContent = "Watch our latest worship service and discover the hope found in Jesus Christ.";
      date.textContent = sermon.date;
      link.href = sermon.url;
      link.textContent = "Open Recording";
    } else {
      const message = document.createElement("div");
      message.className = "player-placeholder";
      message.textContent = "Video temporarily unavailable.";
      player.append(message);
      label.textContent = "Worship Online";
      title.textContent = "Watch Worship";
      description.textContent = "Please check back shortly.";
      date.textContent = "";
      link.href = "https://live.irvingcollege.church";
      link.textContent = "Visit Livestream";
    }
  }

  async function refresh() {
    try {
      const response = await fetch("/.netlify/functions/worship-feed", { cache: "no-store" });
      if (!response.ok) throw new Error("Worship feed unavailable");
      render(await response.json() as Feed);
    } catch (error) {
      console.error(error);
      if (!shown && player) player.textContent = "Video temporarily unavailable. Please try again shortly.";
    }
  }

  refresh();
  window.setInterval(refresh, 30000);
</script>

<style>
  .sermon-layout { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr); align-items:center; gap:clamp(2rem,6vw,5rem); }
  .sermon-video { overflow:hidden; border-radius:1.25rem; box-shadow:0 1.5rem 3.5rem rgba(20,45,35,.16); background:#161616; aspect-ratio:16/9; }
  .sermon-video :global(iframe), .sermon-video :global(video) { display:block; width:100%; height:100%; border:0; }
  .sermon-video :global(.player-placeholder) { display:grid; place-items:center; width:100%; height:100%; color:#fff; padding:1rem; text-align:center; }
  .sermon-content h2 { font-size:clamp(1.8rem,3vw,2.8rem); line-height:1.2; margin:.35rem 0 1rem; }
  .sermon-description { margin:0 0 1.5rem; }
  .sermon-date { margin:-.5rem 0 1.5rem; font-size:.95rem; font-weight:700; }
  .watch-button { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding:.9rem 1.6rem; color:#fff; background:var(--color-primary); border-radius:999px; font-weight:700; text-decoration:none; transition:background-color .2s ease,transform .2s ease; }
  .watch-button:hover, .watch-button:focus-visible { color:#fff; background:var(--color-primary-dark); transform:translateY(-2px); }
  @media(max-width:800px) { .sermon-layout { grid-template-columns:1fr; } }
</style>