---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<div class="section-heading">
  {eyebrow && (
    <span class="eyebrow">{eyebrow}</span>
  )}

  <h2>{title}</h2>

  {text && (
    <p class="lead">
      {text}
    </p>
  )}
</div>